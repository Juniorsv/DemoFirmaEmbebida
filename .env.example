# ===========================================
# DocuSign Developer Credentials
# ===========================================
# Obtén estos valores desde: https://admindemo.docusign.com/apps-and-keys

# Tu Integration Key (Client ID)
DS_INTEGRATION_KEY=tu-integration-key-aqui

# Tu User ID (GUID del usuario)
DS_USER_ID=tu-user-id-aqui

# Tu Account ID
DS_ACCOUNT_ID=tu-account-id-aqui

# Ruta al archivo de llave privada RSA
# (Genera un par de llaves RSA en tu app de DocuSign y guarda la privada aquí)
DS_PRIVATE_KEY_PATH=./private.key

# ===========================================
# Configuración del servidor
# ===========================================
PORT=3000

# URL base de la API de DocuSign (demo)
DS_BASE_URL=https://demo.docusign.net/restapi

# URL de OAuth (demo)
DS_AUTH_SERVER=account-d.docusign.com
